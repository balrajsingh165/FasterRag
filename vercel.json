{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "python3 -m pip install --break-system-packages --disable-pip-version-check -r requirements-docs.txt",
  "buildCommand": "python3 -m mkdocs build --strict --site-dir public",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/intro/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/intro",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
