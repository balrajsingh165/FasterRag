# fasterRag secrets template — copy to .env and fill in what your config.yaml references.
# NEVER commit .env. config.yaml refers to these by NAME only (e.g. api_key_env: OPENAI_API_KEY).
# Full policy: docs/security.md. Variable inventory must stay in sync with that document.

# Control-plane auth (required when security.auth: true)
FASTERRAG_API_KEY=change-me

# Vector DB — Qdrant reference adapter (server enforces via QDRANT__SERVICE__API_KEY)
QDRANT_API_KEY=change-me

# Embedding / LLM providers — only those referenced by config.yaml are required at startup
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# pgvector adapter DSN (only when vector_db.provider: pgvector)
PGVECTOR_DSN=

# Langfuse self-hosted stack (observability.langfuse: true).
# Generated ONCE by the provisioner if absent — preserve forever after creation:
# changing SALT/ENCRYPTION_KEY/NEXTAUTH_SECRET invalidates existing Langfuse credentials.
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_INIT_USER_NAME=
